# 複製這份檔案為 .env，並填入你自己的 Supabase 專案資訊
# 在 Supabase Dashboard > Project Settings > Database > Connection string 取得
# （選 "URI" 格式，記得把 [YOUR-PASSWORD] 換成你設定的資料庫密碼）
SUPABASE_DB_URL=postgresql://postgres:[YOUR-PASSWORD]@[YOUR-PROJECT-REF].supabase.co:5432/postgres

# 前端要改讀 Supabase 時才會用到（Project Settings > API）
VITE_SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
VITE_SUPABASE_ANON_KEY=
