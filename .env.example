# 複製這份檔案為 .env，並填入你自己的 Supabase 專案資訊
# 在 Supabase Dashboard 右上角「Connect」按鈕 > Connection string > URI 取得，
# 再拆成下面幾個欄位（避免密碼裡的特殊符號在單一連線字串裡被誤判）
SUPABASE_DB_HOST=db.[YOUR-PROJECT-REF].supabase.co
# ↑ 直連位址只有 IPv6；若網路不支援 IPv6（例如 GitHub Actions），改用 Connect > Session pooler 的
#   主機（aws-0-<region>.pooler.supabase.com）並把 SUPABASE_DB_USER 設成 postgres.<project-ref>
SUPABASE_DB_PORT=5432
SUPABASE_DB_USER=postgres
SUPABASE_DB_PASSWORD=
SUPABASE_DB_NAME=postgres

# 前端要改讀 Supabase 時才會用到（Project Settings > API Keys）
VITE_SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
VITE_SUPABASE_ANON_KEY=
